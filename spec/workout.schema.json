{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodcraft.dev/schema/1.1/workout.schema.json",
  "title": "WODCraft compiled document",
  "description": "The interchange format produced by compiling a .wod document (WODCraft 1.1, SPEC §13). A document that uses no 1.1 construct is still stamped \"1.0\" and validates as before.",
  "oneOf": [{ "$ref": "#/$defs/workout" }, { "$ref": "#/$defs/session" }],
  "$defs": {
    "amount": {
      "description": "A single number, or one value per category when the source used a dual (43/30).",
      "oneOf": [
        { "type": "number" },
        {
          "type": "object",
          "properties": { "men": { "type": "number" }, "women": { "type": "number" } },
          "required": ["men", "women"],
          "additionalProperties": false
        }
      ]
    },
    "source": {
      "type": "object",
      "description": "1-based position of the statement in the source file.",
      "properties": { "line": { "type": "integer", "minimum": 1 }, "col": { "type": "integer", "minimum": 1 } },
      "required": ["line", "col"],
      "additionalProperties": false
    },
    "load": {
      "type": "object",
      "description": "A load, always exposed in kilograms and pounds.",
      "properties": {
        "kg": { "$ref": "#/$defs/amount" },
        "lb": { "$ref": "#/$defs/amount" },
        "unit": { "enum": ["kg", "lb", "pood"], "description": "the unit written in the source" },
        "written": { "$ref": "#/$defs/amount" },
        "value": { "type": "number", "description": "resolved workouts only: the value in the athlete's units" }
      },
      "required": ["kg"]
    },
    "height": {
      "type": "object",
      "properties": {
        "cm": { "$ref": "#/$defs/amount" },
        "in": { "$ref": "#/$defs/amount" },
        "unit": { "enum": ["cm", "in"] },
        "written": { "$ref": "#/$defs/amount" },
        "value": { "type": "number" }
      },
      "required": ["cm"]
    },
    "quantity": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["reps", "distance", "calories", "time", "max"] },
        "reps": { "$ref": "#/$defs/amount" },
        "m": { "$ref": "#/$defs/amount" },
        "cal": { "$ref": "#/$defs/amount" },
        "s": { "$ref": "#/$defs/amount" },
        "of": { "enum": ["reps", "distance", "calories"], "description": "kind == max: what is counted" },
        "unit": { "type": "string", "description": "the unit written in the source" },
        "written": { "$ref": "#/$defs/amount" }
      },
      "required": ["kind"]
    },
    "movement": {
      "type": "object",
      "properties": {
        "type": { "const": "movement" },
        "movement": { "type": "string", "description": "catalog identifier, e.g. pull_up" },
        "name": { "type": "string" },
        "quantity": { "$ref": "#/$defs/quantity" },
        "load": { "$ref": "#/$defs/load" },
        "height": { "$ref": "#/$defs/height" },
        "distance": { "type": "object", "description": "a per-rep distance, e.g. ten 25 m shuttle runs" },
        "calories": { "type": "object", "description": "a per-rep calorie count" },
        "percent": {
          "type": "object",
          "properties": { "value": { "$ref": "#/$defs/amount" }, "of": { "type": "string" } },
          "required": ["value"]
        },
        "rpe": { "$ref": "#/$defs/amount" },
        "bodyweight": { "$ref": "#/$defs/amount" },
        "sets": {
          "type": "object",
          "properties": { "reps": { "type": "array", "items": { "type": "integer", "minimum": 1 } } },
          "required": ["reps"]
        },
        "modifiers": { "type": "array", "items": { "type": "string" } },
        "factor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "1.1, resolved workouts only — a movement without a quantity (it takes the ladder value) done factor times"
        },
        "or": {
          "type": "array",
          "description": "1.1 — the other options of an alternative (10 Ring row | 8 Scapular pull-up): the athlete does this movement or one of these",
          "items": { "$ref": "#/$defs/movement" },
          "minItems": 1
        },
        "source": { "$ref": "#/$defs/source" }
      },
      "required": ["type", "movement", "name"]
    },
    "rest": {
      "type": "object",
      "properties": {
        "type": { "const": "rest" },
        "seconds": { "type": "number", "minimum": 0 },
        "source": { "$ref": "#/$defs/source" }
      },
      "required": ["type", "seconds"]
    },
    "block": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "for_time",
            "amrap",
            "emom",
            "every",
            "tabata",
            "death_by",
            "max_load",
            "rounds",
            "ladder",
            "slot",
            "buy_in",
            "cash_out"
          ]
        },
        "rounds": { "type": "integer", "minimum": 1 },
        "reps": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "reps_open": { "type": "boolean", "description": "the ladder continues with the same step until the cap" },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 },
        "interval_s": { "type": "number", "exclusiveMinimum": 0 },
        "cap_s": { "type": "number", "exclusiveMinimum": 0 },
        "teams": { "type": "integer", "minimum": 2 },
        "slot": { "oneOf": [{ "enum": ["odd", "even"] }, { "type": "integer", "minimum": 1 }] },
        "used": {
          "type": "object",
          "description": "the block came from a 'use' line",
          "properties": { "path": { "type": "string" }, "title": { "type": ["string", "null"] } },
          "required": ["path"]
        },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "source": { "$ref": "#/$defs/source" }
      },
      "required": ["type", "items"]
    },
    "item": {
      "oneOf": [{ "$ref": "#/$defs/movement" }, { "$ref": "#/$defs/rest" }, { "$ref": "#/$defs/block" }]
    },
    "score": {
      "type": "object",
      "properties": {
        "type": { "enum": ["time", "rounds+reps", "rounds", "reps", "load", "distance", "calories", "none", "multi"] },
        "capped": { "type": "string", "description": "what is scored by an athlete who hits the cap" },
        "tiebreak": { "type": "string" },
        "parts": {
          "type": "array",
          "description": "score == multi: one entry per timed block",
          "items": {
            "type": "object",
            "properties": { "type": { "type": "string" }, "block": { "type": "integer", "minimum": 0 } },
            "required": ["type", "block"]
          }
        }
      },
      "required": ["type"]
    },
    "level_operation": {
      "type": "object",
      "description": "One adaptation applied by a level (Scaled:, Foundations:…).",
      "properties": {
        "movement": { "type": "string" },
        "replace_with": { "type": "string" },
        "name": { "type": "string" },
        "when": {
          "type": "object",
          "description": "restricts the operation to the occurrences carrying these parameters",
          "properties": { "load": { "$ref": "#/$defs/load" }, "height": { "$ref": "#/$defs/height" } }
        },
        "load": { "$ref": "#/$defs/load" },
        "height": { "$ref": "#/$defs/height" },
        "distance": { "type": "object", "description": "a per-rep distance, e.g. ten 25 m shuttle runs" },
        "calories": { "type": "object", "description": "a per-rep calorie count" },
        "percent": { "type": "object" },
        "rpe": { "$ref": "#/$defs/amount" },
        "bodyweight": { "$ref": "#/$defs/amount" },
        "factor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "1.1 — A -> 2x B: the quantities of every occurrence are multiplied"
        },
        "quantity": { "$ref": "#/$defs/quantity", "description": "1.1 — A -> 10 B: the quantity of every occurrence is replaced" },
        "meta": { "type": "object" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "tags": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } },
        "stimulus": { "type": "array", "items": { "type": "string" } },
        "vest": { "$ref": "#/$defs/load" },
        "tiebreak": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" }
      }
    },
    "workout": {
      "type": "object",
      "properties": {
        "wodcraft": { "enum": ["1.0", "1.1"] },
        "kind": { "const": "workout" },
        "title": { "type": ["string", "null"] },
        "blocks": {
          "type": "array",
          "description": "The body of the workout. Usually blocks; a body written as a bare movement line (a strength piece) or a rest keeps that item at the top level.",
          "items": { "$ref": "#/$defs/item" }
        },
        "score": { "$ref": "#/$defs/score" },
        "team": {
          "type": "object",
          "properties": { "size": { "type": "integer", "minimum": 2 } },
          "required": ["size"]
        },
        "levels": {
          "type": "object",
          "propertyNames": { "enum": ["scaled", "intermediate", "foundations"] },
          "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/level_operation" } }
        },
        "meta": { "$ref": "#/$defs/meta" },
        "estimate": {
          "type": "object",
          "properties": {
            "min_s": { "type": "number" },
            "max_s": { "type": "number" },
            "capped_s": { "type": ["number", "null"] }
          },
          "required": ["min_s", "max_s"]
        },
        "resolved": {
          "type": "object",
          "description": "present once the workout has been resolved for an athlete (SPEC §14)",
          "properties": {
            "category": { "enum": ["men", "women"] },
            "level": { "type": "string" },
            "units": { "enum": ["kg", "lb"] }
          },
          "required": ["category", "level", "units"]
        }
      },
      "required": ["wodcraft", "kind", "blocks", "score"]
    },
    "session": {
      "type": "object",
      "properties": {
        "wodcraft": { "enum": ["1.0", "1.1"] },
        "kind": { "const": "session" },
        "title": { "type": ["string", "null"] },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "units": { "enum": ["kg", "lb"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } },
        "stimulus": { "type": "array", "items": { "type": "string" } },
        "estimate": {
          "type": "object",
          "properties": { "min_s": { "type": "number" }, "max_s": { "type": "number" } },
          "required": ["min_s", "max_s"]
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "workout": { "$ref": "#/$defs/workout" },
              "source": { "$ref": "#/$defs/source" }
            },
            "required": ["title", "workout"]
          }
        }
      },
      "required": ["wodcraft", "kind", "sections"]
    }
  }
}
